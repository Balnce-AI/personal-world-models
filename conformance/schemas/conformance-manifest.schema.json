{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-world-models.org/schema/conformance-manifest/1-0-0",
  "type": "object",
  "required": ["schemaVersion", "specificationVersion", "suites", "levels", "claims"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "specificationVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "suites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/suite"}},
    "levels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/level"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "suite": {
      "type": "object",
      "required": ["id", "version", "profile", "format", "status", "features", "fixtures"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
        "version": {"$ref": "#/$defs/version"},
        "profile": {"type": "string", "minLength": 1},
        "format": {"enum": ["wave01-profile-v1", "semantic-vector-v1", "signed-semantic-suite-v1"]},
        "status": {"enum": ["EXPERIMENTAL", "PROVISIONAL", "STABLE", "DEPRECATED"]},
        "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(pwm|hpl|conformance)\\.[a-z0-9.-]+$"}},
        "fixtures": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^conformance/(?:vectors|expectations)/.+\\.json$"}}
      },
      "additionalProperties": false
    },
    "level": {
      "type": "object",
      "required": ["id", "ordinal", "features", "requiredSuites"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
        "ordinal": {"type": "integer", "minimum": 1},
        "features": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "requiredSuites": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "required": ["implementation", "version", "level", "evidence"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "level": {"type": "string"},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
