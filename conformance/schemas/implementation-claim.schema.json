{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-world-models.org/schema/implementation-claim/1-0-0",
  "title": "Signed Semantic Implementation Claim",
  "type": "object",
  "required": ["claim_version", "profile", "profile_status", "implementation", "suite", "execution", "case_results", "exclusions"],
  "properties": {
    "claim_version": {"const": "1.0.0"},
    "profile": {"const": "pwm-signed-semantics-v1"},
    "profile_status": {"const": "PROVISIONAL"},
    "implementation": {
      "type": "object",
      "required": ["id", "version", "adapter_version", "source_commit", "source_uri"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/id"},
        "adapter_version": {"const": "1.0.0"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_uri": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "suite": {
      "type": "object",
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
        "version": {"const": "1.0.0"},
        "sha256": {"$ref": "#/$defs/hex32"}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["started_at", "completed_at", "environment", "runner_uri", "result_uri"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "environment": {"$ref": "#/$defs/id"},
        "runner_uri": {"type": "string", "format": "uri"},
        "result_uri": {"type": "string", "format": "uri"}
      },
      "additionalProperties": false
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["case_id", "status", "output_sha256", "semantic_diff_count"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
          "status": {"const": "PASS"},
          "output_sha256": {"$ref": "#/$defs/hex32"},
          "semantic_diff_count": {"const": 0}
        },
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "hex32": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
