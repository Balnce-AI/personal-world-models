{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-world-models.org/schema/pwm-privacy-boundary/1-0-0",
  "title": "PWM Privacy Boundary",
  "type": "object",
  "required": ["boundaryId", "boundaryKind", "inputPrivacyClass", "outputPrivacyClass", "sourceRefs", "policyRef", "justification", "releasedFields", "approved", "schemaVersion"],
  "properties": {
    "boundaryId": {"type": "string", "minLength": 1},
    "boundaryKind": {"enum": ["REDACTION", "PROOF"]},
    "inputPrivacyClass": {"enum": ["PUBLIC", "LOW", "PERSONAL", "SENSITIVE", "HIGHLY_SENSITIVE"]},
    "outputPrivacyClass": {"enum": ["PUBLIC", "LOW", "PERSONAL", "SENSITIVE", "HIGHLY_SENSITIVE"]},
    "sourceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "policyRef": {"type": "string", "minLength": 1},
    "justification": {"type": "string", "minLength": 1},
    "releasedFields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "approved": {"type": "boolean"},
    "schemaVersion": {"const": "1.0.0"}
  },
  "additionalProperties": false
}
