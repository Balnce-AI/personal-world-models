{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-world-models.org/schema/pwm-prediction-outcome/1-0-0",
  "title": "PWM Prediction Outcome",
  "type": "object",
  "required": ["outcomeId", "predictionId", "observedValue", "outcomeTime", "provenanceRefs", "schemaVersion"],
  "properties": {
    "outcomeId": {"type": "string"},
    "predictionId": {"type": "string"},
    "observedValue": {},
    "outcomeTime": {"type": "string", "format": "date-time"},
    "provenanceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "schemaVersion": {"const": "1.0.0"}
  },
  "additionalProperties": false
}
