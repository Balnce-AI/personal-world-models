{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-world-models.org/schema/hpl-bounded-projection/1-0-0",
  "title": "Experimental HPL Bounded Projection",
  "type": "object",
  "required": ["projectionId", "negotiationId", "requestId", "recipient", "purpose", "capability", "targetProfileId", "issuedAt", "expiresAt", "refreshPolicy", "revocationRef", "allowedUse", "onwardSharing", "sensitivity", "fields", "fieldPrivacy", "provenanceRefs", "canonicalV2Effect"],
  "properties": {
    "projectionId": {"type": "string"},
    "negotiationId": {"type": "string"},
    "requestId": {"type": "string"},
    "recipient": {"type": "string"},
    "purpose": {"type": "string"},
    "capability": {"type": "string"},
    "targetProfileId": {"type": "string"},
    "issuedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "refreshPolicy": {"enum": ["NEVER", "ON_EXPIRY", "ON_CHANGE"]},
    "revocationRef": {"type": ["string", "null"]},
    "allowedUse": {"type": "string"},
    "onwardSharing": {"enum": ["PROHIBITED", "SAME_PURPOSE"]},
    "sensitivity": {"enum": ["PUBLIC", "LOW", "PERSONAL", "SENSITIVE", "HIGHLY_SENSITIVE"]},
    "fields": {"type": "object"},
    "fieldPrivacy": {"type": "object", "additionalProperties": {"enum": ["PUBLIC", "LOW", "PERSONAL", "SENSITIVE", "HIGHLY_SENSITIVE"]}},
    "provenanceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "canonicalV2Effect": {"const": "NONE"}
  },
  "additionalProperties": false
}
