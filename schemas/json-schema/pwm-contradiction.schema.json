{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-world-models.org/schema/pwm-contradiction/1-0-0",
  "title": "PWM Contradiction",
  "type": "object",
  "required": ["contradictionId", "conflictType", "subjectId", "predicate", "validTime", "incompatibleValues", "assertionRefs", "modelRefs", "provenanceRefs", "recordTime", "status", "acceptanceStatus", "detectionMethod", "resolutions", "privacyClass", "effectivePrivacyClass", "schemaVersion"],
  "properties": {
    "contradictionId": {"type": "string", "minLength": 1},
    "conflictType": {"enum": ["ASSERTION_CONFLICT", "MODEL_CONFLICT", "UNCERTAINTY", "TEMPORAL_CHANGE", "PERSPECTIVE_DISAGREEMENT", "GENUINE_CONTRADICTION"]},
    "subjectId": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "validTime": {"type": ["string", "null"]},
    "incompatibleValues": {"type": "array", "minItems": 2},
    "assertionRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "modelRefs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "provenanceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "recordTime": {"type": "string", "format": "date-time"},
    "status": {"enum": ["OPEN", "EXPLAINED", "SUPERSEDED", "RESOLVED", "IRREDUCIBLE", "PERSPECTIVE_DEPENDENT"]},
    "acceptanceStatus": {"enum": ["PROPOSED", "ACCEPTED"]},
    "detectionMethod": {"enum": ["DETERMINISTIC", "SEMANTIC", "MODEL_ASSISTED"]},
    "resolutions": {"type": "array", "items": {"type": "object", "required": ["status", "explanation", "resolver", "recordTime", "provenanceRefs"], "properties": {"status": {"enum": ["EXPLAINED", "SUPERSEDED", "RESOLVED", "IRREDUCIBLE", "PERSPECTIVE_DEPENDENT"]}, "explanation": {"type": "string", "minLength": 1}, "resolver": {"type": "string", "minLength": 1}, "recordTime": {"type": "string", "format": "date-time"}, "provenanceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}, "additionalProperties": false}},
    "privacyClass": {"enum": ["PUBLIC", "LOW", "PERSONAL", "SENSITIVE", "HIGHLY_SENSITIVE"]},
    "effectivePrivacyClass": {"enum": ["PUBLIC", "LOW", "PERSONAL", "SENSITIVE", "HIGHLY_SENSITIVE"]},
    "schemaVersion": {"const": "1.0.0"}
  },
  "additionalProperties": false
}
